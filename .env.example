# Housecall Pro company API key: HCP → App Store → API (MAX plan only).
HCP_API_KEY=

# Slack bot token (xoxb-…). Scopes: chat:write, groups:history, channels:history, users:read.
SLACK_BOT_TOKEN=

# 1 = print messages instead of posting (still reads Slack history if a token is set).
DRY_RUN=1

# Test: send everything to this channel ID instead of the three real channels.
SLACK_TEST_CHANNEL=
